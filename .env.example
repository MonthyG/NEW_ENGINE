# Copy to .env for `npm run dev`. The container reads its settings from the
# environment at runtime instead (docker run -e WAF_IP=...), so nothing here is baked in.

# Public IP of the WAF that customers point their DNS at (shown on the setup page).
# In the container this is WAF_IP; for `npm run dev` it is read from here.
VITE_WAF_IP=223.26.0.228

# Manager API that `npm run dev` proxies /api to (vite.config.ts).
# default: https://localhost:9443
HIWAF_API=https://localhost:9443
